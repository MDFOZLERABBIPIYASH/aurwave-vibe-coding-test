# Aurwave — Environment Variables
#
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.
# Configure production secrets via the Vercel project settings.
# See: docs/13-vercel-deployment.md

# Site
# The production URL is what `app/sitemap.ts` and metadata use to build
# absolute URLs. Set this in Vercel to the deployed URL (or your custom
# domain). Local development can leave it as the localhost fallback.
#
# Current production URL: https://aurwave-vibe-coding-test.vercel.app/
NEXT_PUBLIC_SITE_URL="https://aurwave-vibe-coding-test.vercel.app"

# Contact form recipient
# Used by `src/lib/site.ts` as `siteConfig.email`, which feeds the
# footer mailto link and the contact-form success panel. Set this in
# Vercel to the inbox that should receive contact-form submissions
# (the form itself currently just logs; a real delivery provider will
# land in a follow-up phase).
CONTACT_EMAIL="f.r.p.421l@gmail.com"

# Analytics
# `@vercel/analytics` and `@vercel/speed-insights` are wired in via
# `src/app/layout.tsx`. They auto-register when the project is deployed
# to Vercel — no env vars or API keys are required. The components
# no-op locally and outside Vercel, so there is zero runtime cost in
# other environments.
#
# If you ever switch to Plausible or Umami, set:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Error monitoring (Sentry)
# Set in Vercel project settings. When unset, the Sentry SDK is
# loaded but its `init()` call is skipped, so there is no runtime
# cost on local or staging builds.
#
# How to get a DSN:
#   1. Create a Sentry project at https://sentry.io (or self-host).
#   2. Copy the DSN from Project Settings → Client Keys (DSN).
#   3. Add it to Vercel as SENTRY_DSN.
#   4. Optional: set SENTRY_ORG and SENTRY_PROJECT for source-map
#      upload (we use the official @sentry/nextjs withSentryConfig
#      wrapper for that).
SENTRY_DSN=""
