# Aurwave — Environment Variables
#
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.
# Configure production secrets via the Vercel project settings.
# See: docs/13-vercel-deployment.md

# Site
# The production URL is what `app/sitemap.ts` and metadata use to build
# absolute URLs. Set this in Vercel to the deployed URL (or your custom
# domain). Local development can leave it as the localhost fallback.
NEXT_PUBLIC_SITE_URL="https://aurwave.com"

# Contact form recipient
# Used by `src/lib/site.ts` as `siteConfig.email`, which feeds the
# footer mailto link and the contact-form success panel. Set this in
# Vercel to the inbox that should receive contact-form submissions
# (the form itself currently just logs; a real delivery provider will
# land in a follow-up phase).
CONTACT_EMAIL="f.r.p.421l@gmail.com"

# Analytics (optional — add keys here when wired up in Phase 14)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Error monitoring (optional — Phase 14)
# SENTRY_DSN=""
