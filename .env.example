# Aurwave — Environment Variables
#
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.
# Configure production secrets via Vercel project settings.
# See: docs/13-vercel-deployment.md

# Site
NEXT_PUBLIC_SITE_URL="https://aurwave.com"

# Contact form submission
# (Stubbed in Phase 06 — replace with a real provider later)
CONTACT_EMAIL="hello@aurwave.com"

# Analytics (optional — add keys here when wired up in Phase 14)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Error monitoring (optional — Phase 14)
# SENTRY_DSN=""
